# Build outputs of v32opt (see `make clean`)
/bin/
/build/
/err.txt
/put/*
/monolithic_source.c
/src/*.o
/src/*.d
/src/peephole/*.o
/src/peephole/*.d

# Generated by the test compilations. testing/*/*.asm, *.xml and *.debug are
# committed fixtures (inputs and expected outputs): never ignore them.
*.v32
*.vbin
*.vtex
/testing/primes/*.asm
/testing/primes/*.xml
/testing/primes/*.debug
/testing/primes/*.txt

# Release archives and patches (`make archive` writes ../v32opt-project-YYYYMMDD.zip)
*.zip
*.patch

# Editor / OS litter
.DS_Store
*~
*.swp
